{
    "name": "internal/telemetry",
    "description": "Internal telemetry client: HTTP request records, application signals and dependency links.",
    "type": "library",
    "version": "1.0.0",
    "license": "proprietary",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Internal\\Telemetry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Internal\\Telemetry\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/telemetry-drain"
    ],
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
