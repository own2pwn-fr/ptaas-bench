<?xml version="1.0" encoding="UTF-8"?>
<!--
  Meridian — the Calderwood Group operations console (server side).

  The front end lives in web/ and is built into src/main/resources/static by the
  container image; this module serves it and the API behind it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.5</version>
    <relativePath/>
  </parent>

  <groupId>com.calderwood</groupId>
  <artifactId>meridian-console</artifactId>
  <version>4.11.2</version>
  <name>meridian-console</name>
  <description>Operations console: accounts, consignments, tariffs, approvals and reporting.</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!--
      PINNED ON PURPOSE, and pinned exactly.

      These two come in through the group platform BOM rather than from a decision made
      here. commons-text does the placeholder substitution in notification templates;
      commons-collections is still on the path because the desktop client's saved
      layouts, which the web console kept reading, were written against it. A floating
      range on either one broke a release build once, so both are nailed down and the
      numbers have not been revisited since.
    -->
    <commons.text.version>1.9</commons.text.version>
    <commons.collections.version>3.2.1</commons.collections.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-text</artifactId>
      <version>${commons.text.version}</version>
    </dependency>
    <dependency>
      <groupId>commons-collections</groupId>
      <artifactId>commons-collections</artifactId>
      <version>${commons.collections.version}</version>
    </dependency>

    <!--
      The scripting engine the runtime stopped shipping. A handful of notification
      templates written for the desk in 2016 compute their own dates and totals, and
      they stopped rendering when the platform was upgraded; adding the engine back was
      a smaller change than rewriting templates the desk maintains itself.
    -->
    <dependency>
      <groupId>org.openjdk.nashorn</groupId>
      <artifactId>nashorn-core</artifactId>
      <version>15.4</version>
    </dependency>

    <!-- The platform team's request instrumentation, built from sdk/java. -->
    <dependency>
      <groupId>internal.platform</groupId>
      <artifactId>telemetry-agent</artifactId>
      <version>1.0.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>meridian-console</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
