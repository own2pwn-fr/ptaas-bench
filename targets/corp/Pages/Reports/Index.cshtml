    <div class="card">
        <h3>Download</h3>
        <p>The same figures as a spreadsheet.</p>
        <p><a class="btn" href="/reports/export?format=xlsx">Download</a></p>
    </div>
</div>

<p class="meta">Back to <a href="/workspace">your workspace</a> or on to <a href="/approvals">approvals</a>.</p>
