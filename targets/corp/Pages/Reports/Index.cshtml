@page "/reports"
@{
    ViewData["Title"] = "Reports";
}

<nav class="breadcrumbs"><a href="/">Home</a> / Reports</nav>

<h1>Reports</h1>

<p class="meta">Maintained by the analytics team at Riverside Way. Figures are refreshed overnight from the timesheet system.</p>

<div class="cards">
    <div class="card">
        <h3>Hours by week</h3>
        <p>Your cost centre, week by week.</p>
        <p><a class="btn" href="/api/reports/costs">Open</a></p>
    </div>
    <div class="card">
        <h3>Timesheet export</h3>
        <p>The full timesheet stream, grouped as you ask for it.</p>
        <p><a class="btn" href="/reports/timesheets">Open</a></p>
