#!/usr/bin/env python3
"""Restore the staff services estate to its seeded state.

Rebuilds the database from DEPLOY_SEED, empties the flat logs, and prints one line
describing what is now on disk. Run it twice: the digest must match, and if it does
not, something is still holding state from the previous run.

It is a command inside the container rather than a route, so a person using the
application cannot ask for it.

    /usr/local/bin/state-reset
"""

from __future__ import annotations

import os
import pwd
import shutil
import sys

sys.path.insert(0, os.environ.get("HUB_ROOT", "/srv"))

try:
    from hub.config import settings
    from hub import seed
except Exception as failure:  # noqa: BLE001
    print(f"state-reset: the application is not importable: {failure}", file=sys.stderr)
    raise SystemExit(2)


SERVICE_ACCOUNT = os.environ.get("HUB_ACCOUNT", "app")


def _hand_back(*paths: str) -> None:
    """Leave the rebuilt files owned by the account that serves them.

    An engineer running this by hand is root inside the container, and files root has
    just written are files the service cannot open for writing afterwards.
    """
    if os.geteuid() != 0:
        return
    try:
        account = pwd.getpwnam(SERVICE_ACCOUNT)
    except KeyError:
        return
    for path in paths:
        if not os.path.exists(path):
            continue
        shutil.chown(path, account.pw_uid, account.pw_gid)
        if os.path.isdir(path):
            for entry in os.scandir(path):
                shutil.chown(entry.path, account.pw_uid, account.pw_gid)
    parent = os.path.dirname(paths[0]) if paths else ""
    if parent and os.path.isdir(parent):
        shutil.chown(parent, account.pw_uid, account.pw_gid)


def main() -> int:
    try:
        seed.rebuild(settings.database_path, settings.log_dir,
                     settings.deploy_seed, settings.site_domain)
    except Exception as failure:  # noqa: BLE001
        print(f"state-reset: rebuild failed: {failure}", file=sys.stderr)
        return 1

    try:
        fingerprint, records = seed.digest(settings.database_path)
    except Exception as failure:  # noqa: BLE001
        print(f"state-reset: could not read the rebuilt file: {failure}", file=sys.stderr)
        return 1

    _hand_back(settings.database_path, settings.log_dir)

    people = 0
    try:
        conn = seed.sqlite3.connect(settings.database_path)
        people = conn.execute("SELECT COUNT(*) FROM people").fetchone()[0]
        conn.close()
    except Exception:  # noqa: BLE001
        pass

    print(f"state {fingerprint[:16]} people={people} rows={records}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
