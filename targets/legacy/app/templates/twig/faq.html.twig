{# One of the pages that was moved onto the template engine during the 2016 rebuild.
   The work was stopped part-way, so the native template of the same name is still on
   disk and is what renders where the engine is not installed. #}
{% if items is empty %}
  <p>There is nothing on this page at the moment.</p>
{% else %}
  {% for item in items %}
    <div class="panel">
      <h2>{{ item[0] }}</h2>
      <p>{{ item[1] }}</p>
    </div>
  {% endfor %}
{% endif %}
