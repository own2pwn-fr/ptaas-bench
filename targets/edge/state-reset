#!/bin/sh
# Restore this tier to its seeded state.
#
# Drops in-memory session state and asks the cache tier to invalidate everything, then
# prints a one-line digest of the state that is meant to be constant. Run it twice:
# the digest must match, and if it does not, something is still holding state from the
# previous deployment.
#
# It talks to the loopback operations listener rather than to a route on the public
# port, so it cannot be driven by a customer.
set -eu

ADDR="${CONTROL_ADDR:-127.0.0.1:9901}"

if ! out=$(wget -q -O - -T 15 "http://${ADDR}/reset"); then
    echo "state-reset: operations listener at ${ADDR} did not complete the reset" >&2
    exit 1
fi

case "$out" in
    state\ *) printf '%s\n' "$out" ;;
    *) echo "state-reset: unexpected reply: $out" >&2; exit 1 ;;
esac
