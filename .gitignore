__pycache__/
*.pyc
.venv/
node_modules/
dist/
build/
# Not a bare `bin/`: targets ship an executable state-reset under bin/, and ignoring it
# silently produces an image whose reset command is missing — a failure that surfaces
# only at bring-up, as a target that cannot be returned to its seeded state.
sdk/dotnet/**/obj/
sdk/dotnet/**/bin/
sdk/java/target/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
.env
.DS_Store
# Run artefacts. Published baselines live in results/baselines/ and ARE committed.
results/runs/
